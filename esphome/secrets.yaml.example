# Copy to secrets.yaml (git-ignored) and fill in.

# Site Wi-Fi. May stay as placeholders: on site the gateway opens the
# "Tempem-Remote-Setup" hotspot + captive portal (or use Improv over USB at
# https://web.esphome.io) to pick the real network.
wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME_TOO"

# Password of the fallback setup hotspot (min. 8 characters).
ap_password: "tempem-setup"

# Webhook URL shown by Home Assistant when you add the "Tempem BLE" integration
# and choose "Remote gateway" (Settings -> Devices & services -> Add integration).
# Must be the public HTTPS URL, e.g. through your Cloudflare Tunnel hostname.
tempem_webhook_url: "https://ha.example.com/api/webhook/REPLACE_WITH_WEBHOOK_ID"

# Password for local OTA updates (esphome run / upload over the network).
ota_password: "change-me-ota"

# Password for the local web UI (user "admin") at http://<device-ip>/.
web_password: "change-me-web"
